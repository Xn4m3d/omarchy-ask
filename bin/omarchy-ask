#!/bin/bash

# omarchy:summary=Ask the default coding agent, with the focused window as context
# omarchy:args=[--print-context] [--toggle|--open|--close]
# omarchy:examples=omarchy-ask | omarchy-ask --print-context

# Bound to SUPER+Q. The context has to be collected HERE, before the overlay
# takes keyboard focus: once the layer-shell card is up, "the window the user
# was looking at" is no longer what the compositor reports as active. So this
# gathers the facts, then hands them to the already-running shell as a JSON
# payload — the same summon-with-payload contract omarchy.image-picker uses.

set -uo pipefail

PLUGIN_ID="xn4m3d.ask"
action="toggle"

while (($#)); do
  case "$1" in
    --print-context) action="print" ;;
    --toggle) action="toggle" ;;
    --open) action="summon" ;;
    --close) action="hide" ;;
    -h | --help)
      echo "Usage: omarchy-ask [--print-context] [--toggle|--open|--close]"
      exit 0
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      exit 1
      ;;
  esac
  shift
done

# The cwd of a terminal window is the cwd of the shell running inside it, so
# take the window pid's first direct child. Walking the whole tree to its
# deepest leaf looks more thorough but is worse: it lands on whatever
# short-lived process happens to be running, whose /proc entry is often gone
# by the time we read it.
window_cwd() {
  local pid=$1 child
  [[ $pid =~ ^[0-9]+$ ]] || return 0
  child=$(pgrep -P "$pid" 2>/dev/null | head -1) || return 0
  [[ -n $child ]] || return 0
  readlink "/proc/$child/cwd" 2>/dev/null || true
}

active=$(hyprctl activewindow -j 2>/dev/null)
# No focused window (empty workspace) is normal, not an error: the card still
# opens, just without window context.
[[ -n $active && $active != "null" ]] || active="{}"

pid=$(jq -r '.pid // empty' <<<"$active")
cwd=$(window_cwd "$pid")

payload=$(jq -nc \
  --argjson w "$active" \
  --arg cwd "$cwd" \
  '{
     window: {
       class: ($w.class // ""),
       title: ($w.title // ""),
       address: ($w.address // ""),
       pid: ($w.pid // 0),
       workspace: ($w.workspace.name // ""),
       # Recorded here so the overlay can screenshot that window later: by
       # then the compositor considers the ask card active, and the geometry
       # of "the active window" would be the card.
       geometry: (if ($w.at and $w.size)
                  then "\($w.at[0]),\($w.at[1]) \($w.size[0])x\($w.size[1])"
                  else "" end)
     },
     cwd: $cwd
   }')

if [[ $action == "print" ]]; then
  jq . <<<"$payload"
  exit 0
fi

# hide takes the id alone; only summon and toggle carry a payload.
if [[ $action == "hide" ]]; then
  exec omarchy-shell shell hide "$PLUGIN_ID"
fi

exec omarchy-shell shell "$action" "$PLUGIN_ID" "$payload"
