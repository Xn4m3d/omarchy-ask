#!/bin/bash

# omarchy:summary=Capture an attachment for the ask overlay
# omarchy:args=window <geometry> | region | clipboard
# omarchy:hidden=true

# Produces one attachment file and prints its path on the first line, then a
# short human summary of what is actually in it on the second. The summary is
# what the overlay puts on the chip: "clipboard text" tells you the key fired,
# but not whether it caught the thing you meant to copy, which is the only
# question you have at that moment. The second line is optional -- the overlay
# falls back to a category label without it.
#
# Prints nothing and exits non-zero when there is nothing to attach (selection
# cancelled, empty clipboard), which the overlay reads as "leave the composer
# alone".
#
# The overlay hides itself before calling the screen-capturing modes: it is an
# Overlay-layer surface covering the screen, so anything it does not step out
# of the way for would be a screenshot of the ask card itself.

set -uo pipefail

# slurp reads a list of predefined rectangles from stdin whenever stdin is not
# a TTY. Quickshell hands every child process a pipe it never writes to and
# never closes, so an inherited stdin leaves slurp blocked on a read that can
# never return: no picker is ever mapped, this script never exits, and the
# overlay -- which hides itself for the duration of a capture -- stays hidden
# for good (observed, not theorised: wchan anon_pipe_read, zero layer surface).
# Hyprland's own binds do not hit this because they exec with a different
# stdin, which is why Super+Shift+S works while the same helper called from
# the shell does not.
exec </dev/null

DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-ask"
mkdir -p "$DIR" || exit 1

# XDG_RUNTIME_DIR is cleared at logout, which covers the common case, but a
# machine that stays up for weeks would otherwise keep every screenshot ever
# attached. Best-effort: a failure here must not stop a capture.
find "$DIR" -type f -mmin +1440 -delete 2>/dev/null || true

stamp() { date +'%Y%m%d-%H%M%S-%N' | cut -c1-19; }

# "X,Y WxH" -> "WxH". The picker already knows the size it handed back, so a
# screenshot never needs to be re-read to be described.
geometry_size() { printf '%s' "${1#* }"; }

# file(1) comes from the `file` package, which pacman itself depends on, so it
# is there on any Arch host -- but a missing or unparsable answer costs us the
# dimensions, never the attachment.
image_size() {
  local desc
  desc=$(file -b "$1" 2>/dev/null) || return 1
  [[ $desc =~ ([0-9]+)[[:space:]]*x[[:space:]]*([0-9]+) ]] || return 1
  printf '%sx%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

# The opening words of the text, on one line. Cut at 44 so the chip shows the
# whole label rather than eliding a second time on top of this one -- two
# truncations in one string read as damage, not as brevity.
text_preview() {
  local full
  full=$(tr -s '[:space:]' ' ' <"$1" | sed 's/^ *//; s/ *$//')
  if ((${#full} > 44)); then
    printf '%s...' "${full:0:44}"
  else
    printf '%s' "$full"
  fi
}

# The overlay sets itself invisible before calling us, but a Wayland surface is
# not gone the instant the client asks: the compositor still has to commit a
# frame without it. Capturing immediately catches the card mid-teardown and
# bakes a ghost of it into the screenshot (observed, not theorised). One short
# settle beats a screenshot of our own UI.
settle() { sleep 0.15; }

mode="${1:-}"
[[ -n $mode ]] || {
  echo "Usage: omarchy-ask-capture <window <geometry>|region|clipboard>" >&2
  exit 1
}
shift

case "$mode" in
  window)
    geometry="${1:-}"
    [[ -n $geometry ]] || exit 1
    settle
    out="$DIR/window-$(stamp).png"
    grim -g "$geometry" "$out" || exit 1
    echo "$out"
    echo "window $(geometry_size "$geometry")"
    ;;

  region)
    # omarchy-capture-region owns the frozen-screen picker, so the selection
    # UX here is identical to Super+Shift+S rather than a second, subtly
    # different slurp.
    # Settle before the picker, not just before grim: omarchy-capture-region
    # freezes the screen first, so a card still on screen would be frozen into
    # the very image the user selects from.
    settle
    geometry=$(omarchy-capture-region region) || exit 1
    [[ -n $geometry ]] || exit 1
    out="$DIR/region-$(stamp).png"
    grim -g "$geometry" "$out" || exit 1
    echo "$out"
    echo "region $(geometry_size "$geometry")"
    ;;

  clipboard)
    types=$(wl-paste --list-types 2>/dev/null) || exit 1
    [[ -n $types ]] || exit 1

    # An image on the clipboard is worth attaching as a file; text is worth
    # attaching as text. Checking the offered types is the only way to tell,
    # since wl-paste happily prints binary at you either way.
    if image_type=$(grep -m1 '^image/' <<<"$types"); then
      ext="${image_type#image/}"
      [[ $ext == "jpeg" ]] && ext="jpg"
      case "$ext" in png | jpg | webp | gif | bmp) ;; *) ext="png" ;; esac
      out="$DIR/clipboard-$(stamp).$ext"
      wl-paste --type "$image_type" >"$out" 2>/dev/null || exit 1
      [[ -s $out ]] || { rm -f "$out"; exit 1; }
      if size=$(image_size "$out"); then
        summary="image $size"
      else
        summary="image"
      fi
    else
      out="$DIR/clipboard-$(stamp).txt"
      wl-paste --no-newline >"$out" 2>/dev/null || exit 1
      [[ -s $out ]] || { rm -f "$out"; exit 1; }
      summary=$(text_preview "$out")
    fi
    echo "$out"
    echo "$summary"
    ;;

  *)
    echo "Unknown mode: $mode" >&2
    exit 1
    ;;
esac
